# ============================================================
# FlagIQ AI Summit '26 — environment surface
# Copy to .env.local and fill in. NEVER commit real values.
# This must be the SUMMIT's own Supabase project — never the sign-out's.
# ============================================================

# ---- Supabase ----
# NEXT_PUBLIC_* is exposed to the browser. The anon key is safe there ONLY
# because RLS denies it every table; its one reachable surface is
# get_public_counter(), which returns counts and no money.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Paystack ----
# The existing live business, with its webhook URL repointed to
#   https://<summit-domain>/api/webhooks/paystack
# Paystack signs x-paystack-signature with this key; there is no separate
# webhook secret. Checkout uses the hosted redirect, so no public key is needed.
#
# Put the LIVE key in .env.local too: scripts/purge-test-data.mjs refuses to run
# against sk_live_, and that guard reads this file, not Vercel.
PAYSTACK_SECRET_KEY=""

# ---- Resend (ticket email backup + campaigns) ----
# The from-address must be on a domain verified in Resend, or every send is
# refused as unverified.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# HMAC key for non-enumerable marketing unsubscribe links. Server-only.
# Generate with: openssl rand -base64 32
EMAIL_UNSUBSCRIBE_SECRET=""

# ---- App ----
# Absolute origin, used for OG tags and the Paystack callback URL. When unset
# the code falls back to eventConfig.seo.siteUrl, which is safe once config
# names the real Summit domain.
NEXT_PUBLIC_SITE_URL=""

# ---- Device rate-limit key ----
# HMAC secret for the signed sot_did cookie (lib/api/device-id.ts), so checkout
# can rate-limit per device instead of per carrier-NAT IP. Server-only.
# Generate with: openssl rand -base64 32
# UNSET IS SAFE: checkout falls back to IP-only limiting.
DEVICE_ID_SECRET=""
