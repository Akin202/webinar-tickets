# ============================================================
# Sign-Out Tickets — environment surface
# Copy to .env.local and fill in. NEVER commit real values.
# Nothing here is provisioned yet — see build plan Phase 0.
# ============================================================

# ---- Supabase ----
# NEXT_PUBLIC_* is exposed to the browser. The anon key is safe there
# ONLY because RLS denies it access to orders/tickets/check_ins.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Paystack ----
# Test keys until go-live. Get both from the Paystack dashboard:
#   Settings -> API Keys & Webhooks
# The secret key is server-only and must never reach the browser.
PAYSTACK_SECRET_KEY=""
# NOTE: there is no separate webhook secret. Paystack signs the
# x-paystack-signature header using PAYSTACK_SECRET_KEY above.
#
# There is deliberately no NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY. Checkout uses
# Paystack's hosted redirect (transaction/initialize -> authorization_url),
# not the inline JS SDK, so the public key is never needed. It used to be
# declared here and referenced nowhere, which reads like a missing wiring
# job rather than a design choice.

# ---- Resend (backup ticket delivery; WhatsApp is primary) ----
# Sending domain is send.tickitid.online — a dedicated subdomain, so a
# deliverability problem can never damage the apex's reputation.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="tickets@send.tickitid.online"

# ---- App ----
# Absolute origin. Required for OG tags and Paystack callback URLs.
#
# MUST be set in production. When unset the code falls back to
# eventConfig.seo.siteUrl (app/layout.tsx, app/api/checkout/route.ts,
# lib/email.ts) — so a forgotten env var does not fail loudly, it silently
# ships localhost URLs into WhatsApp previews and Paystack callbacks.
# Production value: https://lastdance.tickitid.online
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Device rate-limit key ----
# HMAC secret for the signed sot_did cookie (lib/api/device-id.ts), which lets
# the checkout limits key on a device instead of on an IP that an entire mobile
# carrier shares behind CGNAT. Server-only — no NEXT_PUBLIC_ prefix, so Next
# never inlines it into a client bundle.
#
# Generate with:  openssl rand -base64 32
#
# UNSET IS SAFE: with no value the cookie is never issued, readDeviceId always
# returns null, isDeviceIdConfigured() reports false, and the routes fall back
# to exactly the IP-only limiting that shipped before this existed. Rotating it
# invalidates every outstanding cookie, which costs one extra mint per device
# and nothing else.
DEVICE_ID_SECRET=""
