# ============================================================
# Sign-Out Tickets — environment surface
# Copy to .env.local and fill in. NEVER commit real values.
# Nothing here is provisioned yet — see build plan Phase 0.
# ============================================================

# ---- Supabase ----
# NEXT_PUBLIC_* is exposed to the browser. The anon key is safe there
# ONLY because RLS denies it access to orders/tickets/check_ins.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Paystack ----
# Test keys until go-live. Get both from the Paystack dashboard:
#   Settings -> API Keys & Webhooks
# The secret key is server-only and must never reach the browser.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# NOTE: there is no separate webhook secret. Paystack signs the
# x-paystack-signature header using PAYSTACK_SECRET_KEY above.

# ---- Resend (backup ticket delivery; WhatsApp is primary) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ---- App ----
# Absolute origin. Required for OG tags and Paystack callback URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
